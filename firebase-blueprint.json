{
  "entities": {
    "AccountEntry": {
      "title": "AccountEntry",
      "description": "A 2FA TOTP or HOTP authenticator entry stored in the shared KIRON - XP vault.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "accountName": {
          "type": "string",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "maxLength": 60
        },
        "caption": {
          "type": "string",
          "maxLength": 300
        },
        "secret": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "type": {
          "type": "string",
          "enum": ["totp", "hotp"]
        },
        "algorithm": {
          "type": "string",
          "enum": ["SHA-1", "SHA-256", "SHA-512"]
        },
        "digits": {
          "type": "number"
        },
        "period": {
          "type": "number"
        },
        "counter": {
          "type": "number"
        },
        "avatarDataUrl": {
          "type": "string",
          "maxLength": 200000
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "issuer",
        "accountName",
        "secret",
        "type",
        "algorithm",
        "digits",
        "period",
        "counter",
        "createdAt"
      ]
    },
    "EmailEntry": {
      "title": "EmailEntry",
      "description": "A saved email credential and note entry in the shared KIRON - XP vault.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "password": {
          "type": "string",
          "maxLength": 200
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "avatarDataUrl": {
          "type": "string",
          "maxLength": 200000
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": ["id", "email", "createdAt", "updatedAt"]
    },
    "NoteEntry": {
      "title": "NoteEntry",
      "description": "A Keep-style diary note entry in the shared KIRON - XP vault.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "maxLength": 20000
        },
        "color": {
          "type": "string",
          "enum": ["default", "emerald", "amber", "sky", "rose", "violet"]
        },
        "pinned": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": ["id", "title", "content", "color", "pinned", "createdAt", "updatedAt"]
    },
    "SheetEntry": {
      "title": "SheetEntry",
      "description": "A spreadsheet table stored using a native Firestore map of non-empty rows.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "rowCount": {
          "type": "number"
        },
        "colCount": {
          "type": "number"
        },
        "rowsMap": {
          "type": "object"
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": ["id", "title", "rowCount", "colCount", "rowsMap", "createdAt", "updatedAt"]
    },
    "RecoveryCode": {
      "title": "RecoveryCode",
      "description": "A one-time recovery code entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "used": {
          "type": "boolean"
        },
        "usedAt": {
          "type": "number"
        }
      },
      "required": ["id", "code", "used"]
    },
    "ProfileMediaEntry": {
      "title": "ProfileMediaEntry",
      "description": "A photo, screenshot, video, saved number, or APK app package entry in the PROFILE vault.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "kind": {
          "type": "string",
          "enum": ["photo", "screenshot", "video", "number", "apk"]
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "maxLength": 60
        },
        "numberValue": {
          "type": "string",
          "maxLength": 120
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "mimeType": {
          "type": "string",
          "maxLength": 100
        },
        "fileName": {
          "type": "string",
          "maxLength": 200
        },
        "fileSize": {
          "type": "number"
        },
        "dataUrl": {
          "type": "string",
          "maxLength": 750000
        },
        "thumbnailDataUrl": {
          "type": "string",
          "maxLength": 200000
        },
        "chunkCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": ["id", "kind", "title", "mimeType", "chunkCount", "createdAt", "updatedAt"]
    },
    "ProfileMediaChunk": {
      "title": "ProfileMediaChunk",
      "description": "A base64 chunk for an HD/4K photo, screenshot, or video uploaded to PROFILE.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mediaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "index": {
          "type": "number"
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 780000
        }
      },
      "required": ["id", "mediaId", "index", "data"]
    },
    "SiteEntryConfig": {
      "title": "SiteEntryConfig",
      "description": "Publicly synced entry gate appearance, bio, social links, and password hash.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "headerTitle": {
          "type": "string",
          "maxLength": 80
        },
        "lockTitle": {
          "type": "string",
          "maxLength": 120
        },
        "lockDesc": {
          "type": "string",
          "maxLength": 240
        },
        "unlockBtnText": {
          "type": "string",
          "maxLength": 60
        },
        "bio": {
          "type": "string",
          "maxLength": 300
        },
        "telegramUrl": {
          "type": "string",
          "maxLength": 300
        },
        "whatsappUrl": {
          "type": "string",
          "maxLength": 300
        },
        "tiktokUrl": {
          "type": "string",
          "maxLength": 300
        },
        "instagramUrl": {
          "type": "string",
          "maxLength": 300
        },
        "wechatUrl": {
          "type": "string",
          "maxLength": 300
        },
        "facebookUrl": {
          "type": "string",
          "maxLength": 300
        },
        "imoUrl": {
          "type": "string",
          "maxLength": 300
        },
        "messengerUrl": {
          "type": "string",
          "maxLength": 300
        },
        "whatsappUrl2": {
          "type": "string",
          "maxLength": 300
        },
        "telegramUrl2": {
          "type": "string",
          "maxLength": 300
        },
        "showSocialLinks": {
          "type": "boolean"
        },
        "showLogo": {
          "type": "boolean"
        },
        "overlayOpacity": {
          "type": "number"
        },
        "wallpaperDataUrl": {
          "type": "string",
          "maxLength": 750000
        },
        "insideWallpaperDataUrl": {
          "type": "string",
          "maxLength": 750000
        },
        "insideOverlayOpacity": {
          "type": "number"
        },
        "entryPasswordHash": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "headerTitle",
        "lockTitle",
        "lockDesc",
        "unlockBtnText",
        "bio",
        "showSocialLinks",
        "showLogo",
        "overlayOpacity",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/AccountEntry" },
      "description": "Shared 2FA TOTP/HOTP accounts synced live across all unlocked clients."
    },
    "/emails/{emailId}": {
      "schema": { "$ref": "#/entities/EmailEntry" },
      "description": "Shared saved email entries synced live across all unlocked clients."
    },
    "/notes/{noteId}": {
      "schema": { "$ref": "#/entities/NoteEntry" },
      "description": "Shared Keep-style diary notes synced live across all unlocked clients."
    },
    "/sheets/{sheetId}": {
      "schema": { "$ref": "#/entities/SheetEntry" },
      "description": "Shared 100-row spreadsheets synced live across all unlocked clients."
    },
    "/recoveryCodes/{codeId}": {
      "schema": { "$ref": "#/entities/RecoveryCode" },
      "description": "Shared emergency recovery codes synced across all unlocked clients."
    },
    "/profileMedia/{mediaId}": {
      "schema": { "$ref": "#/entities/ProfileMediaEntry" },
      "description": "Shared photos, screenshots, videos, and saved numbers in PROFILE."
    },
    "/profileMedia/{mediaId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/ProfileMediaChunk" },
      "description": "Chunked payload storage for videos inside PROFILE."
    },
    "/siteConfig/{configId}": {
      "schema": { "$ref": "#/entities/SiteEntryConfig" },
      "description": "Shared entry screen bio, social links, appearance, and password hash."
    }
  }
}
